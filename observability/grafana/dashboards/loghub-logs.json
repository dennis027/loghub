{
  "uid": "loghub-logs",
  "title": "LogHub \u2014 Log Overview",
  "tags": [
    "loghub",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "loghub-es"
        },
        "query": "{\"find\": \"terms\", \"field\": \"environment\"}",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "loghub-es"
        },
        "query": "{\"find\": \"terms\", \"field\": \"service\"}",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total events",
      "type": "stat",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": []
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 2,
      "title": "Errors + critical",
      "type": "stat",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service AND level:(error OR critical)",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": []
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx",
      "type": "stat",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service AND http.status:>=500",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": []
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "title": "Active services",
      "type": "stat",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "cardinality",
              "id": "1",
              "field": "service"
            }
          ],
          "bucketAggs": []
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "title": "Log volume by level",
      "type": "timeseries",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "level",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Errors by service",
      "type": "barchart",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service AND level:(error OR critical)",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "service",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "xField": "service"
      }
    },
    {
      "id": 7,
      "title": "Events by environment",
      "type": "piechart",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "environment",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Recent errors",
      "type": "logs",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "environment:$environment AND service:$service AND level:(error OR critical)",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "logs",
              "id": "1"
            }
          ],
          "bucketAggs": []
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      }
    }
  ]
}