{
  "uid": "loghub-web",
  "title": "LogHub \u2014 Web & API Traffic",
  "tags": [
    "loghub",
    "http"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests by status",
      "type": "timeseries",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "event_type:http_access OR http.status:*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "http.status",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Top paths",
      "type": "table",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "http.status:*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "http.path",
              "settings": {
                "size": "15",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 3,
      "title": "p95 latency (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "http.duration_ms:*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "percentiles",
              "id": "1",
              "field": "http.duration_ms",
              "settings": {
                "percents": [
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 4,
      "title": "Authentication failures",
      "type": "timeseries",
      "datasource": {
        "type": "elasticsearch",
        "uid": "loghub-es"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "loghub-es"
          },
          "query": "event_type:auth_failure",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      }
    }
  ]
}