# Copy with ./scripts/init-env.sh, which fills every secret below with random values.
# Values marked "generated" must never be committed with real content.

# Optional service groups (comma-separated). Remove "graylog" to save ~2 GB RAM,
# "metrics" to drop Prometheus/node-exporter, add "demo" to run the synthetic log generator.
COMPOSE_PROFILES=graylog,metrics

# Interfaces that published ports bind to. Keep 127.0.0.1 unless a reverse proxy
# or firewall protects the host. INGEST_BIND_ADDRESS covers log ingestion ports.
BIND_ADDRESS=127.0.0.1
INGEST_BIND_ADDRESS=127.0.0.1
PUBLIC_BASE_URL=http://localhost:4200

# ---- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=generated
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,django-api
CSRF_TRUSTED_ORIGINS=http://localhost:4200
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=generated
DEFAULT_ORGANIZATION_SLUG=default
GUNICORN_WORKERS=2
GUNICORN_THREADS=8

# ---- PostgreSQL / Redis -------------------------------------------------
POSTGRES_DB=loghub
POSTGRES_USER=loghub
POSTGRES_PASSWORD=generated
REDIS_PASSWORD=generated

# ---- Elastic stack ------------------------------------------------------
ES_JAVA_OPTS=-Xms768m -Xmx768m
LS_JAVA_OPTS=-Xms384m -Xmx384m
ELASTIC_PASSWORD=generated
KIBANA_SYSTEM_PASSWORD=generated
KIBANA_ENCRYPTION_KEY=generated
LOGSTASH_WRITER_PASSWORD=generated
# Basic-auth credential Fluent Bit and Django use to post to Logstash's HTTP input.
LOGSTASH_HTTP_USER=shipper
LOGSTASH_HTTP_PASSWORD=generated
GRAFANA_READER_PASSWORD=generated
LOGHUB_ES_PASSWORD=generated

# ---- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generated
GRAFANA_VIEWER_PASSWORD=generated

# ---- Graylog (profile: graylog) -----------------------------------------
GRAYLOG_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
MONGO_USER=graylog
MONGO_PASSWORD=generated
GRAYLOG_PASSWORD_SECRET=generated
GRAYLOG_ROOT_PASSWORD=generated
GRAYLOG_ROOT_PASSWORD_SHA2=generated
GRAYLOG_READER_PASSWORD=generated
GRAYLOG_EXTERNAL_URL=http://localhost:9000

# ---- Ingestion ----------------------------------------------------------
# Organization assigned to events that arrive through collectors (forward/syslog/http)
# rather than the token-authenticated Django ingest endpoint.
COLLECTOR_DEFAULT_ORG=default

# ---- Email notifications -----------------------------------------------
# Defaults point at the bundled Mailpit SMTP sink (UI on :8025). Use a real relay in production.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=loghub-alerts@example.com

# ---- Browser-facing links to the integrated UIs --------------------------
KIBANA_PUBLIC_URL=http://localhost:5601
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAYLOG_PUBLIC_URL=http://localhost:9000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
